{
  "name": "@varunindiit/create-rn-starter",
  "version": "2.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Production-ready React Native CLI starter: React Navigation auth flow, bottom tabs, Redux Toolkit, theming, i18n, SVG support, MMKV storage, API/service layer and reusable components. Scaffolds a fully renamed Android + iOS project in seconds.",
  "type": "commonjs",
  "bin": {
    "create-rn-starter": "bin/index.js"
  },
  "files": [
    "bin",
    "lib",
    "template",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint bin lib scripts",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "node --test test/*.test.js",
    "test:smoke": "node scripts/smoke.js",
    "sync": "node scripts/sync-template.js",
    "sync:check": "node scripts/sync-template.js --check"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "react-native",
    "react-native-cli",
    "starter",
    "template",
    "boilerplate",
    "redux",
    "redux-toolkit",
    "rtk-query",
    "react-navigation",
    "typescript",
    "scaffold",
    "cli",
    "dark-mode",
    "i18n",
    "accessibility"
  ],
  "author": "varunindiit <vp@indiit.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/varunindiit/create-rn-starter.git",
    "directory": "create-rn-starter"
  },
  "homepage": "https://github.com/varunindiit/create-rn-starter#readme",
  "bugs": {
    "url": "https://github.com/varunindiit/create-rn-starter/issues"
  },
  "devDependencies": {
    "eslint": "^8.57.1"
  }
}
