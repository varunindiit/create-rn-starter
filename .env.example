# ─────────────────────────────────────────────────────────────────────────────
# Environment configuration
#
# Copy to `.env` (the CLI does this for you on scaffold) and fill in your
# values. `.env` is git-ignored; this file is the tracked, value-free template —
# add a key here whenever you add one to `.env`, and mirror it in
# `declarations.d.ts` so TypeScript knows about it.
#
# Values are inlined at BUILD time by react-native-dotenv, so after editing
# `.env` you must restart Metro with:  npm start -- --reset-cache
#
# Anything in here ships inside the app bundle and is readable by anyone who
# downloads it. Never put a real secret in a mobile app — keys that must stay
# secret belong behind your own API.
# ─────────────────────────────────────────────────────────────────────────────

# Which environment this build points at: development | staging | production
APP_ENV=development

# Base URL of your REST API
REACT_APP_API=http://localhost:3000/api/v1

# Log every request and response. Defaults to on in dev builds.
ENABLE_API_LOGGING=true

# Google API key, if you add Maps/Places (leave blank otherwise)
GOOGLE_MAPS_KEY=

# Crash reporting DSN (leave blank to disable)
SENTRY_DSN=
